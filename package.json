{
  "name": "gwaymaegyi-chess",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "assets": "npm run assets:mark && npm run icons",
    "assets:mark": "python3 scripts/app_mark.py --write",
    "icons": "tauri icon public/favicon.svg -o src-tauri/icons --ios-color \"#295e49\"",
    "android:init": "tauri android init --ci --skip-targets-install && python3 scripts/ci/android_frame.py",
    "check": "svelte-check --tsconfig tsconfig.app.json --fail-on-warnings && node node_modules/typescript-native/bin/tsc -p tsconfig.node.json && node node_modules/typescript-native/bin/tsc -p tsconfig.tests.json",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts vitest.config.ts playwright.config.ts svelte.config.js public/engine/bridge-worker.mjs && python3 scripts/check_repo.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:ci && npm run test && npm run build",
    "verify:all": "npm run verify && npm run lint:workflows && npm run test:e2e",
    "check:commit": "python3 scripts/check_commit.py",
    "test:ci": "python3 -m unittest discover -s tests/ci -p 'test_*.py' -v",
    "lint:workflows": "python3 scripts/ci/workflows.py"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@lichess-org/chessground": "10.4.1",
    "@lucide/svelte": "1.49.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@tauri-apps/api": "2.12.1",
    "chessops": "0.15.1",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.3",
    "daisyui": "5.7.47",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
